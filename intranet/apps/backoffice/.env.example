# Server-only configuration. Never use VITE_ for these values.
INTRANET_AUTH_MODE=tailscale
# AWS uses INTRANET_AUTH_MODE=tailscale-alb and a server-only router endpoint:
# INTRANET_IDENTITY_URL=http://10.203.0.10:3101/identity
# Convex HTTP actions origin (.site, not .cloud).
INFRA_FUTURO_API_URL=https://polite-spider-810.convex.site
# Same value as CONVEX_HTTP_API_TOKEN on that Convex deployment.
INFRA_FUTURO_API_TOKEN=
# Typed admin API (convex/admin): the deployment's .cloud URL, and the same value as
# ADMIN_API_SECRET on that deployment. Generate one with: openssl rand -hex 32
INFRA_FUTURO_CONVEX_URL=https://polite-spider-810.convex.cloud
INFRA_FUTURO_ADMIN_SECRET=

# Optional local development only. Remove before running the production server.
# INTRANET_DEV_USER=organizer@example.com
