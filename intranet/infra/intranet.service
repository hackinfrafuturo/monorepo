[Unit]
Description=Intranet backoffice
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=intranet
Group=intranet
WorkingDirectory=/opt/infrastructure-hackathon/intranet/apps/backoffice
EnvironmentFile=/etc/intranet.env
Environment=NODE_ENV=production
Environment=PORT=3100
ExecStart=/usr/bin/node scripts/start.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
